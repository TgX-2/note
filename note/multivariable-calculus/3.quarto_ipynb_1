        "#| echo: true\n",
        "#| code-fold: true\n",
        "#| warning: false\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = np.linspace(-3, 3, 15)\n",
        "y = np.linspace(-3, 3, 15)\n",
        "X, Y = np.meshgrid(x, y)\n",
        "\n",
        "U = X\n",
        "V = np.zeros_like(X)\n",
        "\n",
        "magnitude = np.sqrt(U**2 + V**2)\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "q = plt.quiver(\n",
        "    X, Y, U, V,\n",
        "    magnitude,\n",
        "    cmap=\"viridis\",\n",
        "    angles=\"xy\",\n",
