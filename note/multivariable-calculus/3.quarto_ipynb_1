        "\n",
        "plt.xlim(-0.5, 1.5)\n",
        "plt.ylim(-0.5, 1.5)\n",
        "plt.gca().set_aspect(\"equal\", adjustable=\"box\")\n",
        "\n",
        "plt.xlabel(\"$x$\")\n",
