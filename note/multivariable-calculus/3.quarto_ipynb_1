        "#| echo: true\n",
        "#| code-fold: true\n",
        "#| warning: false\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Miền x\n",
        "x = np.linspace(-0.5, 1.5, 500)\n",
        "\n",
        "# Hàm y = x\n",
        "y1 = x\n",
        "\n",
        "y2 = np.where(x >= 0, np.sqrt(x), np.nan)\n",
        "\n",
