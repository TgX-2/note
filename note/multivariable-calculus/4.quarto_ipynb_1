      "source": [
        "Công thức:\n",
        "\n",
        "$$\n",
        "x = \\rho\\sin\\phi\\cos\\theta \\\\ \n",
        "y = \\rho\\sin\\phi\\sin\\theta \\\\ \n",
        "z = \\rho\\cos\\phi\n",
        "$$\n",
        "\n",
        "và \n",
        "\n",
        "$$\n",
        "\\rho = \\sqrt{x ^2 + y^2 + z^2} = \\sqrt{r^2 + z^2}\n",
        "$$\n",
        "\n",
        "## Tích phân bội ba trong tọa độ cầu\n",
        "\n",
        "$$\n",
        "\\mathrm dV = \\rho^2\\sin\\phi \\mathrm d\\rho \\mathrm d\\phi\\mathrm d\\theta \n",
        "$$\n",
        "\n",
        ":::{.callout-note collapse=\"true\"}\n",
        "## The Jacobians\n",
        "\n",
        "Ta có:\n",
        "\n",
        "$$\n",
        "x = \\rho\\sin\\phi\\cos\\theta \\qquad y = \\rho\\sin\\phi\\sin\\theta \\qquad z = \\rho\\cos\\phi\n",
        "$$\n",
        "\n",
        "$$\n",
        "J = \\frac{\\partial(x, y, z)}{\\partial(\\rho, \\phi, \\theta)} = \\begin{vmatrix}\n",
        "x_\\rho & x_\\phi & x_\\theta \\\\ \n",
        "y_\\rho & y_\\phi & y_\\theta \\\\ \n",
        "z_\\rho & z_\\phi & z_\\theta \n",
        "\\end{vmatrix}\n",
        "$$\n",
        "\n",
        "$$\n",
        "J = x_\\rho\\begin{vmatrix} \n",
        "y_\\phi & y_\\theta \\\\ \n",
        "z_\\phi & z_\\theta \n",
        "\\end{vmatrix} - x_\\phi\\begin{vmatrix}\n",
        "y_\\rho & y_\\theta \\\\ \n",
        "z_\\rho & z_\\theta \n",
        "\\end{vmatrix} + x_\\theta\\begin{vmatrix}\n",
        "y_\\rho & y_\\phi \\\\ \n",
        "z_\\rho & z_\\phi \n",
        "\\end{vmatrix}\n",
        "$$\n",
        "\n",
        "$$\n",
        "x_\\rho = \\sin\\phi\\cos\\theta \\qquad \n",
        "x_\\phi = \\rho\\cos\\phi\\cos\\theta \\qquad \n",
        "x_\\theta = -\\rho\\sin\\phi\\sin\\theta \\\\ \n",
        "y_\\rho = \\sin\\phi\\sin\\theta \\qquad \n",
        "y_\\phi = \\rho\\cos\\phi\\sin\\theta \\qquad \n",
        "y_\\theta = \\rho\\sin\\phi\\cos\\theta \\\\ \n",
        "z_\\rho = \\cos\\phi \\qquad \n",
        "z_\\phi = -\\rho\\sin\\phi \\qquad\n",
        "z_\\theta = 0\n",
        "$$\n",
        "\n",
        "$$\n",
