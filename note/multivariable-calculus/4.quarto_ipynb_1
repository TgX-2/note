    "#| echo: true\n",
    "#| code-fold: true\n",
    "#| warning: false\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "R = 1.0\n",
    "z0 = 1 / np.sqrt(2)\n",
    "\n",
    "fig = plt.figure(figsize=(6, 6))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "\n",
    "u = np.linspace(0, 2*np.pi, 200)\n",
    "v = np.linspace(0, np.pi, 150)\n",
    "\n",
    "U, V = np.meshgrid(u, v)\n",
    "\n",
    "X = R * np.cos(U) * np.sin(V)\n",
    "Y = R * np.sin(U) * np.sin(V)\n",
    "Z = R * np.cos(V)\n",
    "\n",
    "\n",
    "Xu = np.ma.masked_where(Z < z0, X)\n",
    "Yu = np.ma.masked_where(Z < z0, Y)\n",
    "Zu = np.ma.masked_where(Z < z0, Z)\n",
    "\n",
    "ax.plot_surface(\n",
    "    Xu, Yu, Zu,\n",
    "    cmap='plasma',\n",
    "    rcount=180,\n",
    "    ccount=180,\n",
    "    linewidth=0,\n",
    "    antialiased=True,\n",
    "    shade=True,\n",
    "    alpha=1\n",
    ")\n",
    "\n",
    "Xl = np.ma.masked_where(Z > z0, X)\n",
    "Yl = np.ma.masked_where(Z > z0, Y)\n",
    "Zl = np.ma.masked_where(Z > z0, Z)\n",
    "\n",
    "ax.plot_surface(\n",
    "    Xl, Yl, Zl,\n",
    "    cmap='viridis',\n",
    "    rcount=180,\n",
    "    ccount=180,\n",
    "    linewidth=0,\n",
    "    antialiased=True,\n",
    "    shade=True,\n",
    "    alpha=0.5\n",
    ")\n",
    "\n",
    "r = np.sqrt(R**2 - z0**2)\n",
    "\n",
    "x = np.linspace(-r, r, 200)\n",
    "y = np.linspace(-r, r, 200)\n",
    "\n",
    "Xp, Yp = np.meshgrid(x, y)\n",
    "\n",
    "mask = Xp**2 + Yp**2 <= r**2\n",
    "\n",
    "Xp = np.ma.masked_where(~mask, Xp)\n",
    "Yp = np.ma.masked_where(~mask, Yp)\n",
    "Zp = np.ma.masked_where(~mask, np.full_like(Xp, z0))\n",
    "\n",
    "ax.plot_surface(\n",
    "    Xp, Yp, Zp,\n",
    "    color='white',\n",
    "    alpha=0.70,\n",
    "    linewidth=0,\n",
    "    shade=False\n",
    ")\n",
    "\n",
    "t = np.linspace(0, 2*np.pi, 500)\n",
    "\n",
    "xc = r * np.cos(t)\n",
    "yc = r * np.sin(t)\n",
    "zc = np.full_like(t, z0)\n",
    "\n",
    "ax.plot(\n",
    "    xc, yc, zc,\n",
    "    color='black',\n",
    "    linewidth=3\n",
    ")\n",
    "\n",
    "lim = 1.05\n",
    "\n",
    "ax.set_xlim(-lim, lim)\n",
    "ax.set_ylim(-lim, lim)\n",
    "ax.set_zlim(-lim, lim)\n",
    "\n",
    "\n",
    "ax.set_box_aspect((1, 1, 1))\n",
    "\n",
    "ax.view_init(elev=28, azim=45)\n",
    "\n",
    "ax.set_xlabel(r'$x$', fontsize=16)\n",
    "ax.set_ylabel(r'$y$', fontsize=16)\n",
    "ax.set_zlabel(r'$z$', fontsize=16)\n",
    "\n",
    "ax.grid(True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
